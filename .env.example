# Copy to .env and fill in. .env is git-ignored (chmod 600).
#
# Primary LLM — any OpenAI-compatible endpoint works. All options below are
# reachable from mainland China without a proxy (verified):
#   SiliconFlow (free quota):  base https://api.siliconflow.cn/v1, model deepseek-ai/DeepSeek-V3
#   Alibaba Bailian (free):    base https://dashscope.aliyuncs.com/compatible-mode/v1, model qwen-plus
#   Zhipu GLM (free quota):    base https://open.bigmodel.cn/api/paas/v4, model glm-4-flash
#   DeepSeek (paid, cheap):    base https://api.deepseek.com, model deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# Optional: override API hosts (e.g. Kalshi sandbox, or a proxy relay).
# Kalshi sandbox is reachable directly; production and Polymarket are blocked
# from mainland China and need an overseas proxy (HTTPS_PROXY/ALL_PROXY).
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional: web-search API for the proactive research agent (v2), Serper-compatible.
# Serper's free tier (2500 queries, no credit card) is reachable from mainland China.
# Without a key the real-mode research agent reports empty evidence and abstains (no silent fail).
# SEARCH_API_KEY=
# SEARCH_API_URL=https://google.serper.dev/search

# Optional: second model for dual-model abstention. Point it at a *different*
# provider from the primary (e.g. primary SiliconFlow, second Bailian) so the
# anchor is a genuinely independent model. Defaults to the primary endpoint/key
# when unset; identical model+endpoint disables it (no double spend).
# SECOND_LLM_MODEL=qwen-plus
# SECOND_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SECOND_LLM_API_KEY=
